{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tpcamponesuite.app/contracts/registration/catalog.work.snapshot.v1.schema.json",
  "title": "Catalog work snapshot (Rights Registration Hub feed v1.0, pre-production revision 3)",
  "description": "Every stored Catalog field is a required key; JSON null = supported but empty; empty strings are rejected. Releases are listed once and linked from recordings. Relationship checks (unique ids, every link resolves, no orphan release) are enforced by catalogRelationshipIssues in the TypeScript contract. Catalog never sends ownership, rights, mandates, signing authority or registration status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "workspace_id",
    "work_uid",
    "source_record_id",
    "source_revision",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "catalog.work.snapshot"
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "work_uid": {
      "$ref": "#/$defs/id"
    },
    "source_record_id": {
      "$ref": "#/$defs/id"
    },
    "source_revision": {
      "$ref": "#/$defs/id"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "alternate_titles",
        "iswc",
        "language",
        "genre",
        "duration_seconds",
        "creation_date",
        "copyright_date",
        "copyright_owner",
        "work_type",
        "version_type",
        "territory",
        "work_code",
        "publisher_reference",
        "recordings",
        "releases"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "alternate_titles": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 500,
                "pattern": "\\S"
              }
            }
          }
        },
        "iswc": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "^\\S(.*\\S)?$"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "\\S"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "\\S"
        },
        "duration_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "creation_date": {
          "$ref": "#/$defs/date"
        },
        "copyright_date": {
          "$ref": "#/$defs/date"
        },
        "copyright_owner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "work_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "pattern": "\\S"
        },
        "version_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "pattern": "\\S"
        },
        "territory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "\\S"
        },
        "work_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "publisher_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "^\\S(.*\\S)?$"
        },
        "recordings": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/recording"
          }
        },
        "releases": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 360000
    },
    "position": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9999
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "recording_uid",
        "title",
        "artist",
        "isrc",
        "version",
        "duration_seconds",
        "recording_date",
        "release_date",
        "label",
        "studio",
        "genre",
        "language",
        "explicit",
        "pline",
        "release_links"
      ],
      "properties": {
        "recording_id": {
          "$ref": "#/$defs/id"
        },
        "recording_uid": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "\\S"
        },
        "artist": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "\\S"
        },
        "isrc": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "^\\S(.*\\S)?$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "\\S"
        },
        "duration_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "recording_date": {
          "$ref": "#/$defs/date"
        },
        "release_date": {
          "$ref": "#/$defs/date"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "studio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "\\S"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "\\S"
        },
        "explicit": {
          "type": "boolean"
        },
        "pline": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "release_links": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/release_link"
          }
        }
      }
    },
    "release_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "track_number",
        "disc_number"
      ],
      "properties": {
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "track_number": {
          "$ref": "#/$defs/position"
        },
        "disc_number": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "title",
        "upc",
        "catalog_number",
        "release_date",
        "release_type",
        "label",
        "distributor",
        "territory",
        "genre",
        "pline",
        "cline"
      ],
      "properties": {
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "\\S"
        },
        "upc": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "^\\S(.*\\S)?$"
        },
        "catalog_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "release_date": {
          "$ref": "#/$defs/date"
        },
        "release_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "pattern": "\\S"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "distributor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "territory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "\\S"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "pattern": "\\S"
        },
        "pline": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        },
        "cline": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    }
  }
}
